# ==============================================================================
# Beamer & Thesis Automation Pipeline - Git Ignore
# ==============================================================================

# Python & Virtual Environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/
__pycache__/
*.py[codz]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.pytest_cache/
.coverage
htmlcov/

# Binary Downloads (Compiler binaries downloaded dynamically per OS)
agent_helper/bin/*
!agent_helper/bin/.gitkeep

# ------------------------------------------------------------------------------
# Privacy Protection: User-Specific Working Documents & Personal Data
# (Keep private presentations, drafts, theses, and assets out of version control)
# ------------------------------------------------------------------------------
input/**
!input/
!input/**/.gitkeep
!input/**/README.md

digestion/**
!digestion/
!digestion/.gitkeep
!digestion/README.md

output/**
!output/
!output/**/.gitkeep
!output/README.md

archive/**
!archive/
!archive/.gitkeep
!archive/README.md

template_override/**
!template_override/
!template_override/.gitkeep

# ------------------------------------------------------------------------------
# Public Samples are always tracked
# ------------------------------------------------------------------------------
!samples/
!samples/**

# Generated Artifacts, Archives & LaTeX Cache
*.pdf
*.zip
*.tar.gz
*.aux
*.log
*.nav
*.out
*.snm
*.toc
*.vrb
*.fls
*.fdb_latexmk
*.synctex.gz

# Operating System & Editor Metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Project internal setup logs
llm-conscience/
llm-conscience
